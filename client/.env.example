# Client Environment Variables
# Copy this file to .env.local and fill in your values before running the dev server
# or building for production.
#
# IMPORTANT: If VITE_BACKEND_ROOT_URL is not set at build time,
# the app will fall back to http://127.0.0.1:5000 (localhost).
# This WILL break production deployments — always set this variable.

# URL of the deployed backend (no trailing slash)
# Example: https://api.yourdomain.com
VITE_BACKEND_ROOT_URL=http://127.0.0.1:5000

# The URL segment used for the admin dashboard route (default: "admin")
# Example: if set to "secret-panel", admin is at /secret-panel/dashboard
VITE_FRONTEND_ADMIN_URL=admin
